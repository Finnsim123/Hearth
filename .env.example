# Copy to .env and fill in. These are the ONLY secrets configured outside the UI.
HEARTH_SECRET=change-me-32-random-chars        # encrypts stored tokens at rest

# ── Only needed when running the BUNDLED InfluxDB profile ──────────────────
#    (docker compose --profile influxdb up -d)
#    If you connect an EXISTING InfluxDB instead, skip all of this and enter
#    URL/org/token in the onboarding wizard.
INFLUX_TOKEN=change-me-influx-admin-token
INFLUX_PASSWORD=change-me
HEARTH_INFLUX_URL=http://influxdb:8086

# Optional
HEARTH_LOG_LEVEL=INFO
GRAFANA_PASSWORD=hearth
