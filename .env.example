# Copy to .env and fill in. These are the ONLY secrets configured outside the UI.
HEARTH_SECRET=change-me-32-random-chars        # encrypts stored tokens at rest

# ── Bundled InfluxDB (ships with Hearth, starts automatically) ─────────────
#    install.sh generates these. In the wizard you choose whether Hearth uses
#    the bundled InfluxDB or your own; bring your own and the bundled one just
#    stays idle (these values then go unused).
INFLUX_TOKEN=change-me-influx-admin-token       # API token: shared to Hearth (HEARTH_INFLUX_TOKEN)
INFLUX_PASSWORD=change-me                        # InfluxDB WEB UI login (user "hearth") at :8086 — to browse raw data
HEARTH_INFLUX_URL=http://influxdb:8086

# ── Bundled MQTT broker (only used with: docker compose --profile mqtt) ────
#    install.sh generates this. The broker is published on 1883 to your LAN
#    so external hubs can subscribe, so it does NOT accept anonymous clients.
#    Enter it in Settings -> Connections -> MQTT as user "hearth".
MQTT_PASSWORD=change-me-mqtt-password           # bundled Mosquitto login (user "hearth")

# Optional
HEARTH_LOG_LEVEL=INFO
